# Normalise line endings.
#
# Files are stored with LF in the repository and checked out with LF
# everywhere, which stops the endless "LF will be replaced by CRLF" churn on
# Windows and keeps diffs identical across platforms.
* text=auto eol=lf

# Windows-only scripts must keep CRLF or they will not execute.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary assets — never normalised, never diffed as text.
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.webp   binary
*.avif   binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.eot    binary
*.pdf    binary
*.zip    binary

# Generated bundles should not count towards language statistics or inflate diffs.
dist/**          linguist-generated=true -diff
package-lock.json linguist-generated=true
