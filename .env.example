# Copy this file to `.env` and fill in your real keys.
# Never commit `.env` — it is git-ignored.

PORT=3000

# Client-facing gateway security. Generate a secret with:
#   openssl rand -hex 32
# Then use: VISHROUTER_API_KEYS=local:<generated-secret>
VISHROUTER_AUTH_MODE=required
VISHROUTER_API_KEYS=
RATE_LIMIT_REQUESTS_PER_MINUTE=60

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
